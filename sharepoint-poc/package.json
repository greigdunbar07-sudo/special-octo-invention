{
  "name": "covetrus-sharepoint-portal-poc",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0 < 23.0.0"
  },
  "scripts": {
    "artifacts:build": "node scripts/build-embedded-artifacts.mjs",
    "artifacts:check": "node scripts/check-package-safety.mjs",
    "build": "npm run artifacts:build && npm run artifacts:check && heft test --clean --production",
    "clean": "heft clean",
    "eject-webpack": "heft eject-webpack",
    "package": "npm run build && heft package-solution --production",
    "start": "npm run artifacts:build && heft start --clean"
  },
  "dependencies": {
    "tslib": "2.3.1",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "@fluentui/react": "^8.106.4",
    "@microsoft/sp-core-library": "1.23.2",
    "@microsoft/sp-component-base": "1.23.2",
    "@microsoft/sp-property-pane": "1.23.2",
    "@microsoft/sp-page-context": "1.23.2",
    "@microsoft/sp-webpart-base": "1.23.2",
    "@microsoft/sp-lodash-subset": "1.23.2",
    "@microsoft/sp-office-ui-fabric-core": "1.23.2"
  },
  "devDependencies": {
    "@microsoft/eslint-plugin-spfx": "1.23.2",
    "@microsoft/eslint-config-spfx": "1.23.2",
    "@microsoft/spfx-web-build-rig": "1.23.2",
    "@microsoft/spfx-heft-plugins": "1.23.2",
    "@rushstack/heft": "1.2.17",
    "@types/jest": "30.0.0",
    "@types/webpack-env": "~1.15.2",
    "css-loader": "~7.1.2",
    "eslint": "9.37.0",
    "typescript": "~5.8.0",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "eslint-plugin-react-hooks": "5.2.0",
    "@microsoft/sp-module-interfaces": "1.23.2"
  },
  "overrides": {
    "@rushstack/heft": "1.2.17"
  },
  "resolutions": {
    "@types/react": "17.0.45"
  }
}
