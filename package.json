{
  "name": "covetrus-launchpad",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run artifacts:build",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "build:client": "npm run build",
    "build:server": "tsc --project server/tsconfig.json && node scripts/copy-runtime-package.mjs && node scripts/check-runtime-packager.mjs",
    "build:all": "npm run build:client && npm run build:server",
    "start": "node dist-server/server/index.js",
    "db:migrate": "node dist-server/server/migrate.js",
    "db:grant-runtime": "node dist-server/server/grant-runtime.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "pretest": "npm run artifacts:build",
    "test": "vitest run --configLoader runner",
    "artifacts:validate": "node scripts/validate-artifacts.mjs",
    "artifacts:import": "node scripts/import-artifact.mjs",
    "artifacts:build": "node scripts/build-artifacts.mjs",
    "security:dependencies": "npm audit --audit-level=high",
    "smoke": "npm run lint && npm test && npm run build:all"
  },
  "dependencies": {
    "@azure/identity": "^4.11.1",
    "@azure/storage-blob": "^12.28.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.1.11",
    "ajv": "^8.20.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "hammerjs": "^2.0.8",
    "helmet": "^8.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.33.0",
    "mssql": "^12.0.0",
    "multer": "^2.2.0",
    "parse5": "^8.0.1",
    "postcss": "^8.5.26",
    "postcss-value-parser": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/mssql": "^9.1.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^24.1.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  }
}
