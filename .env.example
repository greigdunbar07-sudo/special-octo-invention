# Production settings are injected by Azure App Service/Bicep.
NODE_ENV=production
PORT=8080
ALLOWED_TENANT_ID=f5a44614-2e0f-46dd-89af-a59b298f02af
BOOTSTRAP_ADMIN_EMAIL=greig.dunbar@covetrus.com
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=insight-hub
AZURE_STORAGE_ACCOUNT=yourstorageaccount
AZURE_STORAGE_CONTAINER=portal-data

# Usage collection is disabled until explicitly piloted. Enable Insights only
# after the telemetry migration is deployed and event collection is verified.
USAGE_TELEMETRY_MODE=off
ENABLE_USAGE_INSIGHTS=false
USAGE_EVENT_RETENTION_DAYS=180

# Authentication is handled by App Service Authentication (Easy Auth), not
# application secrets or Vite variables. Azure credentials use managed identity.
