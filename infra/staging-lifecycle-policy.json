{
  "rules": [
    {
      "enabled": true,
      "name": "delete-expired-artifact-staging",
      "type": "Lifecycle",
      "definition": {
        "actions": {
          "baseBlob": {
            "delete": {
              "daysAfterModificationGreaterThan": 1
            }
          }
        },
        "filters": {
          "blobTypes": ["blockBlob"],
          "prefixMatch": ["portal-data/staging/"]
        }
      }
    }
  ]
}
